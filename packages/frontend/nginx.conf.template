# ${BACKEND_HOST} is substituted at container startup via envsubst.
# Nginx variables ($host, $uri, etc.) are NOT substituted because NGINX_ENVSUBST_TEMPLATE_VARS
# restricts substitution to BACKEND_HOST only.

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Proxy REST API to backend service
    location /api/ {
        proxy_pass         http://${BACKEND_HOST}:3001/api/;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Proxy Socket.io (WebSocket upgrade)
    location /socket.io/ {
        proxy_pass         http://${BACKEND_HOST}:3001/socket.io/;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade    $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_set_header   Host       $host;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # SPA — all other paths serve index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
