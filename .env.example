# TableSchnappi local stack — copy to .env and pick ONE model backend.
#
#   cp .env.example .env
#   podman compose up --build
#
# The assistant drives the whole demo through tool calls, so the model you
# choose must support tool/function calling. A model without it will chat but
# never book anything.

# ── Option A: local model with RamaLama ───────────────────────────────────────
# Run the model on the host, in a separate terminal:
#
#   ramalama serve --port 8081 qwen2.5:7b
#
# Then keep the three lines below as they are. `host.containers.internal`
# resolves to your laptop from inside the container under Podman.
#
# On Docker, change the host to host.docker.internal:
#   MODEL_BASE_URL=http://host.docker.internal:8081
#
# qwen2.5:7b is a reasonable default: it does tool calling and fits in ~8GB.
# llama3.1:8b works too. Smaller instruct models often skip tool calls.
MODEL_BASE_URL=http://host.containers.internal:8081
MODEL_NAME=qwen2.5:7b
MODEL_API_KEY=EMPTY

# ── Option B: shared MaaS gateway ─────────────────────────────────────────────
# Comment out Option A above and uncomment these. Ask whoever runs the gateway
# for the host and a token, and check the exact model string with:
#
#   curl -H "Authorization: Bearer $TOKEN" https://<maas-host>/v1/models
#
# MODEL_BASE_URL=https://<maas-host>
# MODEL_NAME=<model-id-from-/v1/models>
# MODEL_API_KEY=<your-token>

# ── Optional: MLflow tracing ──────────────────────────────────────────────────
# Leave empty for local runs. The assistant falls back to its built-in prompt
# and skips tracing entirely.
MLFLOW_TRACKING_URI=
